{
  "schema_version": 1,
  "purpose": "Proposal regression specifications, not executed app tests.",
  "evidence_notice": "All titles, descriptions, metadata, and retrieval scores below are synthetic fixtures, not facts about real games. Each case's catalog is complete for that case. Historical reports were used only to motivate the policy.",
  "conventions": {
    "judgments": [
      "supported",
      "partially_supported",
      "unsupported"
    ],
    "predicate_states": [
      "supported",
      "contradicted",
      "unknown"
    ],
    "null_judgment": "Definitive judgment deferred because request interpretation requires clarification.",
    "evidence_rule": "Use only the case's supplied catalog; description fields have synthetic publisher provenance; community tags are unverified.",
    "partial_display": "Clearly state supported aspects and unknown gaps; never claim the whole request is fulfilled.",
    "default_scope": "Same game, edition, and mode unless the request or evidence explicitly distinguishes them."
  },
  "cases": [
    {
      "id": "01_compound_all_supported",
      "input": {
        "request": "A cooperative underwater exploration game",
        "catalog": [
          {
            "id": "A",
            "title": "Synthetic A",
            "evidence": [
              {
                "id": "A.description",
                "field": "description",
                "provenance": "synthetic publisher catalog",
                "text": "Two players cooperate to explore submerged ruins."
              }
            ]
          }
        ]
      },
      "expected": {
        "judgments": [
          {
            "candidate_id": "A",
            "judgment": "supported",
            "predicates": {
              "cooperative": "supported",
              "underwater exploration": "supported"
            },
            "display": "recommend"
          }
        ]
      },
      "rationale": "One applicable passage entails both required qualities; exact keyword overlap is unnecessary."
    },
